# =============================================================================
# VoxSales AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME="VoxSales AI"
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32+-character-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voxsales:voxsales@localhost:5432/voxsales
# For Alembic (sync driver):
SYNC_DATABASE_URL=postgresql://voxsales:voxsales@localhost:5432/voxsales

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── LiveKit (Real-time Voice) ───────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret-here

# ─── LLM Provider — Mistral AI ───────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest
# Alternative models: mistral-medium-latest, open-mixtral-8x22b, open-codestral-mamba
MISTRAL_TEMPERATURE=0.7
MISTRAL_MAX_TOKENS=512

# ─── Speech-to-Text Provider ─────────────────────────────────────────────────
STT_PROVIDER=deepgram        # deepgram | assemblyai | google | whisper
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_MODEL=nova-2

# ─── Text-to-Speech Provider ─────────────────────────────────────────────────
TTS_PROVIDER=elevenlabs      # elevenlabs | cartesia | playht | openai
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
CARTESIA_API_KEY=your-cartesia-api-key-here
PLAYHT_API_KEY=your-playht-api-key-here
PLAYHT_USER_ID=your-playht-user-id-here

# ─── n8n Workflow Automation ─────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change-me-to-a-random-secret
# n8n API key for programmatic workflow triggering
N8N_API_KEY=your-n8n-api-key-here

# ─── Telephony (Production — SIP / LiveKit SIP) ──────────────────────────────
TELEPHONY_PROVIDER=none      # none | livekit_sip | twilio | vonage
# LiveKit SIP settings (when TELEPHONY_PROVIDER=livekit_sip)
LIVEKIT_SIP_TRUNK_ID=your-sip-trunk-id
LIVEKIT_SIP_DISPATCH_RULE_ID=your-dispatch-rule-id
# Twilio settings (when TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Calendar Integration ────────────────────────────────────────────────────
CALENDAR_PROVIDER=none       # none | google | caldav
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ─── CRM Integration ─────────────────────────────────────────────────────────
CRM_PROVIDER=none            # none | hubspot | salesforce | pipedrive
HUBSPOT_API_KEY=

# ─── Campaign Execution ──────────────────────────────────────────────────────
# Maximum simultaneous outbound calls (keep low in development)
MAX_CONCURRENT_CALLS=3
# Delay between call batches in seconds
CALL_BATCH_DELAY_SECONDS=5
# Maximum retries for a failed call
MAX_CALL_RETRIES=3

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
